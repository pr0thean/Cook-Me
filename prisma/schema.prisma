generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  title       String      @unique
  slug        String      @unique
  description String?
  ingredients Json?       @db.Json
  instruction Json?       @db.Json
  time        Int?
  difficulty  Difficulty  @default(MEDIUM)
  imageUrl    String?
  posts       Post[]
  postImages  PostImage[]
  categories  Category[]  @relation("CategoryToRecipe")
  tags        Tag[]       @relation("RecipeToTag")

  @@map("recipes")
}

model Category {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  recipes   Recipe[] @relation("CategoryToRecipe")

  @@map("categories")
}

model Tag {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String   @unique
  recipes   Recipe[] @relation("RecipeToTag")

  @@map("tags")
}

/// A user's post under a recipe: text and/or up to 3 photos (`PostImage`)
model Post {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Plain text (max 1000 characters); null for a photo-only post
  content   String?
  /// Hidden by the admin: invisible to everyone, including the author
  hidden    Boolean     @default(false)
  /// Set when the author edits the text
  editedAt  DateTime?   @map("edited_at") @db.Timestamptz(6)
  recipeId  Int         @map("recipe_id")
  userId    Int         @map("user_id")
  recipe    Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    PostImage[]

  @@index([recipeId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

/// A photo of a post. Stores `recipeId` and `createdAt` too, so photo feeds don't need to join posts to sort/filter.
model PostImage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  postId    Int      @map("post_id")
  recipeId  Int      @map("recipe_id")
  /// Order within the post (0-2)
  position  Int
  /// Object path in the `post-images` bucket: `{recipeId}/{postId}/{position}.{ext}`
  path      String
  width     Int
  height    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([recipeId, createdAt])
  @@index([createdAt])
  @@map("post_images")
}

model User {
  id              Int        @id @default(autoincrement())
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Supabase auth user id (auth.users.id) — the link between the auth user and this row
  authId          String     @unique @map("auth_id") @db.Uuid
  name            String
  email           String     @unique
  role            Role       @default(USER)
  status          UserStatus @default(PENDING)
  approvedAt      DateTime?  @map("approved_at") @db.Timestamptz(6)
  joinReason      String?    @map("join_reason")
  /// Admin only: when the admin last opened the posts list (drives the "new posts" badge)
  lastSeenPostsAt DateTime?  @map("last_seen_posts_at") @db.Timestamptz(6)
  posts           Post[]

  @@map("users")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD

  @@map("difficulty")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum UserStatus {
  PENDING
  APPROVED
  BANNED

  @@map("user_status")
}
