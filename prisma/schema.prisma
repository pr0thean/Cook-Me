generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  title       String     @unique
  slug        String     @unique
  description String?
  ingredients Json?      @db.Json
  instruction Json?      @db.Json
  time        Int?
  difficulty  Difficulty @default(MEDIUM)
  imageUrl    String?
  comments    Comment[]
  categories  Category[] @relation("CategoryToRecipe")
  tags        Tag[]      @relation("RecipeToTag")

  @@map("recipes")
}

model Category {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  recipes   Recipe[] @relation("CategoryToRecipe")

  @@map("categories")
}

model Tag {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String   @unique
  recipes   Recipe[] @relation("RecipeToTag")

  @@map("tags")
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  content   String
  imageUrl  String?
  recipeId  Int      @map("recipe_id")
  userId    Int      @map("user_id")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model User {
  id              Int        @id @default(autoincrement())
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Supabase auth user id (auth.users.id) — the link between the auth user and this row
  authId          String     @unique @map("auth_id") @db.Uuid
  name            String
  email           String     @unique
  role            Role       @default(USER)
  status          UserStatus @default(PENDING)
  approvedAt      DateTime?  @map("approved_at") @db.Timestamptz(6)
  joinReason      String?    @map("join_reason")
  /// Admin only: when the admin last opened the posts list (drives the "new posts" badge)
  lastSeenPostsAt DateTime?  @map("last_seen_posts_at") @db.Timestamptz(6)
  comments        Comment[]

  @@map("users")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD

  @@map("difficulty")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum UserStatus {
  PENDING
  APPROVED
  BANNED

  @@map("user_status")
}
